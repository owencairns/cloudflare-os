{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "router",
  "main": "src/index.ts",
  "compatibility_date": "2026-02-02",

  // Gatekeeper service bindings (GATEKEEPER_*) are added dynamically at deploy time — by the
  // deploy service for customer instances, from the release manifest's binding templates. Only
  // the static backend binding is checked in.
  "services": [
    {
      "binding": "WORKSHOP_BACKEND",
      "service": "workshop-backend"
    }
  ],

  // The router owns the public origin for customer instances, so it serves the frontend.
  // `run_worker_first` keeps API and gatekeeper prefixes on the worker; everything else falls
  // through to static assets with SPA fallback.
  "assets": {
    "directory": "../workshop-frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/mcp",
      "/mcp/*",
      // The OAuth authorization server (see packages/workshop-backend/src/auth/oauth/). The
      // well-known prefixes cover the spec's path-inserted variants. `/oauth/approve` is absent on
      // purpose: the approval screen is a frontend route and must be served from assets.
      "/.well-known/oauth-protected-resource",
      "/.well-known/oauth-protected-resource/*",
      "/.well-known/oauth-authorization-server",
      "/.well-known/oauth-authorization-server/*",
      "/oauth/register",
      "/oauth/authorize",
      "/oauth/token",
      "/blueprint-screenshot",
      "/blueprint-screenshot/*",
      "/gatekeeper/*"
    ]
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false }
  }
}
